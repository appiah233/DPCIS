# Examination Hub Frontend - Public Environment Variable Template (Placeholders Only)
# Optional for local dev: VITE_API_BASE_URL defaults to http://127.0.0.1:8000 when unset.
# Use frontend/.env.development.local for npm run dev overrides only (avoids polluting local npm run build).
# Vercel/production builds must configure VITE_API_BASE_URL explicitly. NEVER put server secrets here.

# Public Managed Better Auth URL for the active Neon branch.
VITE_NEON_AUTH_URL=
VITE_API_BASE_URL=http://127.0.0.1:8000
