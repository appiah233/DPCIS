# Examination Hub - Environment Variable Template (Placeholders Only)
# Copy backend settings into backend/.env and frontend public settings into frontend/.env.
# NEVER commit populated .env files or real credentials.
# NEVER prefix server secrets (DATABASE_URL, DIRECT_DATABASE_URL, NEON_AUTH_JWKS_URL) with VITE_.

# --- Backend (FastAPI / Pydantic Settings) ---
APP_NAME=Examination Hub API
APP_VERSION=0.1.0
APP_ENV=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173

# Neon PostgreSQL connection strings
# Runtime traffic (pooled Neon endpoint recommended in deployed environments)
DATABASE_URL=
# Optional direct (non-pooler) Neon connection string for Alembic migrations
DIRECT_DATABASE_URL=

# Neon Managed Better Auth
NEON_AUTH_BASE_URL=
NEON_AUTH_JWKS_URL=
NEON_AUTH_AUDIENCE=

# --- Frontend (Vite Public Environment Variables Only) ---
# Only VITE_* variables are exposed to browser JavaScript bundles.
VITE_NEON_AUTH_URL=
VITE_API_BASE_URL=http://localhost:8000
