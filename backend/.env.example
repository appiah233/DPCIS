# Examination Hub Backend - Environment Variable Template (Placeholders Only)
# Optional for zero-config /health defaults; copy to backend/.env for local DB/Auth config. NEVER commit backend/.env.

APP_NAME=Examination Hub API
APP_VERSION=0.1.0
APP_ENV=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Neon PostgreSQL connection strings
DATABASE_URL=
DIRECT_DATABASE_URL=

# Neon Managed Better Auth (server-only JWT verification)
NEON_AUTH_BASE_URL=
NEON_AUTH_JWKS_URL=
NEON_AUTH_AUDIENCE=
